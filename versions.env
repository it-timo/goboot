# ==============================================================================
# Centralized Version Management for Local Development
# ==============================================================================
#
# This file contains all Docker image versions used in local development:
#   - Makefile (include versions.env)
#   - Taskfile.yml (dotenv support)
#   - scripts/lint.sh (source as shell)
#   - .pre-commit-config.yaml (source as shell)
#
# Using tags for developer convenience (easier to read and update).
# GitLab CI uses SHA256 digests in .gitlab/ci/versions.yml for security.
# GitHub Actions maintains separate pinned SHAs (no native YAML include support).
#
# NOTE: Using = instead of := for compatibility with both Make and shell sourcing
# ==============================================================================

# ------------------------------------------------------------------------------
# Linter Versions
# ------------------------------------------------------------------------------
export GOLANGCI_LINT_VERSION=v2.7.2
export YAMLLINT_VERSION=0.35.9
export MARKDOWNLINT_VERSION=v0.47.0
export CHECKMAKE_VERSION=latest-0.5
export SHELLCHECK_VERSION=v0.11.0
export SHFMT_VERSION=v3.12.0
export EDITORCONFIG_CHECKER_VERSION=v3.6.0
