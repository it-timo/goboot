################################################################################################
#  GitLab CI test job
#
#  This job is used to test the project.
#  It uses the Go version specified in the matrix.
#
#  File generated by goboot — do not reuse blindly.
################################################################################################

test-branch:
  stage: test
  allow_failure: true
  rules:
{{- $branches := .AutoBranches }}
{{- if $branches }}
{{- range $branch := $branches }}
    - if: $CI_COMMIT_TAG == null && $CI_PIPELINE_SOURCE != 'merge_request_event' && $CI_COMMIT_BRANCH != '{{ $branch }}'
{{- end }}
{{- else }}
    - if: $CI_COMMIT_TAG == null && $CI_PIPELINE_SOURCE != 'merge_request_event' && $CI_COMMIT_BRANCH != 'main' && $CI_COMMIT_BRANCH != 'master'
{{- end }}
      when: manual
  parallel:
    matrix:
{{- $versions := .GoVersions }}
{{- if $versions }}
{{- range $version := $versions }}
      - GO_VERSION: "{{ $version }}"
{{- if eq $.ImagePolicy "strict" }}
        GO_DIGEST: "$GO_{{ replace $version "." "_" }}_DIGEST"
{{- end }}
{{- end }}
{{- else }}
      - GO_VERSION: "latest"
{{- end }}
{{- if eq .ImagePolicy "strict" }}
  image: golang@${GO_DIGEST}
{{- else }}
  image: golang:${GO_VERSION}
{{- end }}
  script:
{{- $cmds := index .FileScripts "test.yml" }}
{{- if $cmds }}
{{- range $cmd := $cmds }}
    - {{ oneLine $cmd }}
{{- end }}
{{- else }}
    - echo "No test commands registered."
{{- end }}
  coverage: '/^total:\s+\(statements\)\s+(\d+\.\d+)%/'
  artifacts:
    when: always
    paths:
      - coverage.txt
    expire_in: 1 week

test-auto:
  stage: test
  only:
{{- $branches := .AutoBranches }}
{{- if $branches }}
{{- range $branch := $branches }}
    - "{{ $branch }}"
{{- end }}
{{- else }}
    - main
    - master
{{- end }}
  except:
    - tags
  parallel:
    matrix:
{{- $versions := .GoVersions }}
{{- if $versions }}
{{- range $version := $versions }}
      - GO_VERSION: "{{ $version }}"
{{- if eq $.ImagePolicy "strict" }}
