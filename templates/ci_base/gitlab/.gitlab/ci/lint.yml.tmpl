######################################################
#  GitLab CI lint job
#
#  This job is used to lint the project.
#
#  File generated by goboot — do not reuse blindly.
#
#  It is recommended to modify this file directly
#  and replace the tag versions with sha256 digests.
######################################################

lint:
  stage: lint
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
  image: $DOCKER_IMAGE
  services:
    - name: $DOCKER_IMAGE
      alias: docker
  script:
    - ROOT_DIR="${CI_PROJECT_DIR:-$PWD}"
    - DOCKER_RUN_CMD="docker run --rm -v ${ROOT_DIR}:/workdir -w /workdir"
    - SH_FILES=$(find . -type f -name "*.sh" -not -path "./templates/*")
{{- $cmds := index .FileScripts "lint.yml" }}
{{- if $cmds }}
{{- range $cmd := $cmds }}
    - {{ oneLine (replace (replace $cmd "{{DOCKER_RUN}}" "$DOCKER_RUN_CMD") "{{SH_FILES}}" "$SH_FILES") }}
{{- end }}
{{- else }}
    - echo "No lint commands registered."
{{- end }}
