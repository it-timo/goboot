################################################################################################
# GitLab supply-chain security jobs generated by goboot.
################################################################################################

dependency-policy:
  stage: security
{{- $versions := .GoVersions }}
{{- if $versions }}
{{- if eq .ImagePolicy "strict" }}
  image: golang@$GO_{{ replace (index $versions 0) "." "_" }}_DIGEST
{{- else }}
  image: golang:{{ index $versions 0 }}
{{- end }}
{{- else }}
  image: golang:latest
{{- end }}
  script:
    - go mod download
{{- $cmds := index .FileScripts "security.yml" }}
{{- range $cmd := $cmds }}
    - |-
{{ indent 6 $cmd }}
{{- end }}
  rules:
    - if: $CI_COMMIT_TAG == null

sbom:
  stage: security
  image:
    name: anchore/syft:v1.46.0
    entrypoint: [""]
  script:
    - syft dir:. -o cyclonedx-json=sbom.cdx.json
  artifacts:
    name: sbom-cyclonedx
    paths:
      - sbom.cdx.json
    expire_in: 1 week
  rules:
    - if: $CI_COMMIT_TAG == null
