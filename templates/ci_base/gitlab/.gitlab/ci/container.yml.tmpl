################################################################################################
#  GitLab CI container job
#
#  This job validates generated container configuration and builds the application image.
#
#  File generated by goboot — do not reuse blindly.
################################################################################################

container:
  stage: build
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
  image: $DOCKER_IMAGE
  services:
    - name: $DOCKER_IMAGE
      alias: docker
  script:
{{- $cmds := index .FileScripts "container.yml" }}
{{- if $cmds }}
{{- range $cmd := $cmds }}
    - {{ oneLine $cmd }}
{{- end }}
{{- else }}
    - echo "No container commands registered."
{{- end }}
