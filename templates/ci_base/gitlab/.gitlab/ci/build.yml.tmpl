################################################################################################
#  GitLab CI build job
#
#  This job is used to build the project.
#  It uses the Go version specified in the matrix.
#
#  File generated by goboot — do not reuse blindly.
################################################################################################

build:
  stage: build
{{- if index .FileAllowFailure "build.yml" }}
  allow_failure: true
{{- end }}
  parallel:
    matrix:
{{- $versions := .GoVersions }}
{{- if $versions }}
{{- range $version := $versions }}
      - GO_VERSION: "{{ $version }}"
{{- if eq $.ImagePolicy "strict" }}
        GO_DIGEST: "$GO_{{ replace $version "." "_" }}_DIGEST"
{{- end }}
{{- end }}
{{- else }}
      - GO_VERSION: "latest"
{{- end }}
{{- if eq .ImagePolicy "strict" }}
  image: golang@${GO_DIGEST}
{{- else }}
  image: golang:${GO_VERSION}
{{- end }}
  script:
{{- $cmds := index .FileScripts "build.yml" }}
{{- if $cmds }}
{{- range $cmd := $cmds }}
    - {{ oneLine $cmd }}
{{- end }}
{{- else }}
    - echo "No build commands registered."
{{- end }}
