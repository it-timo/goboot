stages:
{{- if index .FileScripts "lint.yml" }}
  - lint
{{- end }}
{{- if index .FileScripts "test.yml" }}
  - test
{{- end }}
{{- if index .FileScripts "build.yml" }}
  - build
{{- else if index .FileScripts "container.yml" }}
  - build
{{- end }}
{{- if index .FileScripts "security.yml" }}
  - security
{{- end }}
{{- if index .FileScripts "release.yml" }}
  - release
{{- end }}

{{- if .EnabledJobFiles }}
include:
  - local: ".gitlab/ci/versions.yml"
  - local: ".gitlab/ci/commands.yml"
{{- range $file := .EnabledJobFiles }}
  - local: "{{ if $.CIDir }}{{ $.CIDir }}/{{ $file }}{{ else }}{{ $file }}{{ end }}"
{{- end }}
{{- end }}
