name: Lint

# Generated by goboot. Review and adapt for your project.
# In strict mode, replace all sha256:REPLACE_ME values before production use.

{{- $branches := .AutoBranches }}
on:
  push:
    branches:
{{- if $branches }}
{{- range $branch := $branches }}
      - "{{ $branch }}"
{{- end }}
{{- else }}
      - "main"
      - "master"
{{- end }}
  pull_request:
    branches:
{{- if $branches }}
{{- range $branch := $branches }}
      - "{{ $branch }}"
{{- end }}
{{- else }}
      - "main"
      - "master"
{{- end }}

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-24.04
{{- if eq .ImagePolicy "strict" }}
    env:
      GOLANGCI_LINT_IMAGE: "golangci/golangci-lint@sha256:REPLACE_ME"
      YAMLLINT_IMAGE: "pipelinecomponents/yamllint@sha256:REPLACE_ME"
      MARKDOWNLINT_IMAGE: "ghcr.io/igorshubovych/markdownlint-cli@sha256:REPLACE_ME"
      CHECKMAKE_IMAGE: "cytopia/checkmake@sha256:REPLACE_ME"
      SHELLCHECK_IMAGE: "koalaman/shellcheck@sha256:REPLACE_ME"
      SHFMT_IMAGE: "mvdan/shfmt@sha256:REPLACE_ME"
      EDITORCONFIG_CHECKER_IMAGE: "mstruebing/editorconfig-checker@sha256:REPLACE_ME"
{{- end }}
    permissions:
      contents: read
    steps:
      - name: Checkout code
        # Used commit SHA for actions/checkout@v4.2.2
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683

      - name: Run lint commands
        run: |
          set -euo pipefail
          ROOT_DIR="{{ "${{ github.workspace }}" }}"
          DOCKER_RUN="docker run --rm -v ${ROOT_DIR}:/workdir -w /workdir"
          SH_FILES="$(find . -type f -name '*.sh' -not -path './templates/*' | tr '\n' ' ')"
{{- $cmds := index .FileScripts "lint.yml" }}
{{- if $cmds }}
{{- range $cmd := $cmds }}
{{ indent 10 (replace (replace (oneLine $cmd) "{{DOCKER_RUN}}" "${DOCKER_RUN}") "{{SH_FILES}}" "${SH_FILES}") }}
{{- end }}
{{- else }}
          echo "No lint commands registered."
{{- end }}
