name: Bug report
description: Report reproducible behavior that differs from the documented contract.
title: "bug: "
labels:
  - bug
body:
  - type: markdown
    attributes:
      value: |
        Thank you for helping improve {{.ProjectName}}. Do not report security vulnerabilities here; use SECURITY.md.
  - type: textarea
    id: observed
    attributes:
      label: Observed behavior
      description: Describe what happened, including the complete error output.
    validations:
      required: true
  - type: textarea
    id: expected
    attributes:
      label: Expected behavior
      description: Describe the documented or intended result.
    validations:
      required: true
  - type: textarea
    id: reproduce
    attributes:
      label: Reproduction
      description: Provide the smallest configuration and command sequence that reproduces the issue.
      render: shell
    validations:
      required: true
  - type: input
    id: version
    attributes:
      label: Version or commit
      placeholder: v0.4.0 or commit SHA
    validations:
      required: true
  - type: textarea
    id: environment
    attributes:
      label: Environment
      description: Include OS, architecture, Go version, and container runtime where relevant.
    validations:
      required: true
