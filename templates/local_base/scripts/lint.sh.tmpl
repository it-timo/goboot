#!/usr/bin/env bash
#  -----------------------------------------------------------------------------
#  Lint Script — Static Analysis for `{{ .ProjectName }}`
#  -----------------------------------------------------------------------------
#
#  Runs configured linters with consistent command wiring.
#
#  Linters are dynamically injected during scaffolding based on project config.
#
#  Usage:
#    ./scripts/lint.sh
#
#  Requirements:
#    - Registered lint commands in config
#    - Either Docker access or equivalent local tools
#
#  Generated by goboot. Review and adapt for your project.
#  -----------------------------------------------------------------------------

set -euo pipefail

# -----------------------------------------------------------------------------
# Setup
# -----------------------------------------------------------------------------
ROOT_DIR="$(pwd)"
DOCKER_RUN="docker run --rm --network host -v ${ROOT_DIR}:/workdir -w /workdir"
# shellcheck disable=SC2312 # find failures are still surfaced by set -e in this script context.
mapfile -d '' -t SH_FILES < <(
  find . \
    -path './.git' -prune -o \
    -path './.idea' -prune -o \
    -path './.gitlab-ci-local' -prune -o \
    -path './bin' -prune -o \
    -path './outputs' -prune -o \
    -type f -name '*.sh' -print0
)
SH_FILES_ARG=""
if ((${#SH_FILES[@]} > 0)); then
  printf -v SH_FILES_ARG '%q ' "${SH_FILES[@]}"
fi

run() {
  local -r cmd="$1"
  echo "Running: ${cmd}"
  bash -lc "${cmd}"
  echo "✓ Done: ${cmd}"
  echo
}

# -----------------------------------------------------------------------------
# Execute Enabled Linters
# -----------------------------------------------------------------------------

echo "Starting lint process for '{{ .ProjectName }}'..."
echo ""

{{- $linters := index .TaskScripts "base_lint" }}
{{- if not $linters }}
echo "No linters are currently configured. Nothing to do."
exit 0
{{- else }}
{{- range $linter := $linters }}

run "{{ replace (replace $linter "{{DOCKER_RUN}}" "${DOCKER_RUN}") "{{SH_FILES}}" "${SH_FILES_ARG}" | oneLine }}"

{{- end }}

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------

echo "All configured linters completed successfully."
exit 0
{{- end }}
