# Task aliases for local workflows in `{{.ProjectName}}`.
# Generated by goboot; adjust as needed.

version: "3"

# Setup.

vars:
  DOCKER_RUN: 'docker run --rm --network host -v "$PWD":/workdir -w /workdir'
  SH_FILES:
    sh: >-
      find .
      -path './.git' -prune -o
      -path './.idea' -prune -o
      -path './.gitlab-ci-local' -prune -o
      -path './bin' -prune -o
      -path './outputs' -prune -o
      -type f -name '*.sh' -print0
      | xargs -0 printf '%q '

# Task definitions.

{{- $linters := index .TaskScripts "base_lint" }}
{{- $tests := index .TaskScripts "base_test" }}
{{- $docker := index .TaskScripts "base_docker" }}
{{- if or $linters $tests $docker }}
tasks:
  default:
    desc: Run default developer workflow
    deps:
      {{- if $linters }}
      - lint
      {{- end }}
      {{- if $tests }}
      - test
      {{- end }}
      {{- if $docker }}
      - container-check
      {{- end }}

  {{- if $linters }}
  lint:
    desc: Run linters
    cmds:
      {{- range $cmd := $linters }}
      - |
{{ indent 10 (replace (replace $cmd "{{DOCKER_RUN}}" "{{.DOCKER_RUN}}") "{{SH_FILES}}" "{{.SH_FILES}}") }}
      {{- end }}
  {{- end }}

  {{- if $tests }}
  test:
    desc: Run tests
    cmds:
      - |
{{ indent 10 (index $tests 0) }}
  {{- end }}

  {{- if $docker }}
  docker-build:
    desc: Build the project container image
    cmds:
      - |
{{ indent 10 (index $docker 0) }}

  compose-up:
    desc: Start the compose stack
    cmds:
      - |
{{ indent 10 (index $docker 1) }}

  container-check:
    desc: Validate compose and image build
    cmds:
      - |
{{ indent 10 (replace (index $docker 2) " && " " &&\n") }}
  {{- end }}
{{- end }}
