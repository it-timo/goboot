{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/it-timo/goboot/main/schemas/base_governance.schema.json",
  "title": "goboot base_governance configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourcePath": { "type": "string", "minLength": 1 },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@" }
    },
    "defaultBranch": { "type": "string", "minLength": 1 }
  }
}
